{
  "cleanUrls": true,
  "crons": [
    { "path": "/api/premium?action=reconcile", "schedule": "15 3 * * *" }
  ],
  "rewrites": [
    { "source": "/s/:k/:id", "destination": "/api/share?k=:k&id=:id" }
  ],
  "headers": [
    { "source": "/artists/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/config.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ]}
  ]
}
